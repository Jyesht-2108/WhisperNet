# ──────────────────────────────────────────────
# WhisperNet Backend — Environment Configuration
# ──────────────────────────────────────────────

# OpenAI API Key (required for ephemeral token / SDP exchange)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Databricks Configuration
DATABRICKS_ENDPOINT_URL=https://your-databricks-workspace.cloud.databricks.com/serving-endpoints/whispernet-lore/invocations
DATABRICKS_API_TOKEN=dapi-your-databricks-token-here

# Set to "true" to use mock Databricks data (for local dev without live Databricks)
USE_MOCK_DATABRICKS=true

# CORS Origins (comma-separated, Chrome Extension IDs will go here)
CORS_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000,http://localhost:5173

# Server Configuration
APP_ENV=development
LOG_LEVEL=info
