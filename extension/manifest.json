{
  "manifest_version": 3,
  "name": "WhisperNet",
  "description": "Browser-Native AI Copilot for Audio Storytelling — Interact with characters from your favorite audio stories in real-time.",
  "version": "1.0.0",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "*://*.pocketfm.com/*",
    "*://pocketfm.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": ["*://*.pocketfm.com/*", "*://pocketfm.com/*"],
      "js": ["src/content/content.tsx"],
      "run_at": "document_idle"
    }
  ]
}
